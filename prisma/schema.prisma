generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String      @id
  shop                String
  state               String
  isOnline            Boolean     @default(false) @map("is_online")
  scope               String?
  expires             DateTime?
  accessToken         String      @default("") @map("access_token")
  userId              BigInt?     @map("user_id")
  firstName           String?     @map("first_name")
  lastName            String?     @map("last_name")
  email               String?
  accountOwner        Boolean     @default(false) @map("account_owner")
  locale              String?
  collaborator        Boolean     @default(false)
  emailVerified       Boolean     @default(false) @map("email_verified")
  refreshToken        String?     @map("refresh_token")
  refreshTokenExpires DateTime?   @map("refresh_token_expires")

  @@map("sessions")
}

model Shop {
  id                Int       @id @default(autoincrement())
  shopDomain        String    @unique @map("shop_domain")
  accessToken       String    @default("") @map("access_token")
  planType          String    @default("free") @map("plan_type")
  status            String    @default("active")
  chargeId          String?   @map("charge_id")
  monthlyQuota      Int       @default(50) @map("monthly_quota")
  uninstallDate     DateTime? @map("uninstall_date")
  dataRetentionUntil DateTime? @map("data_retention_until")
  lastQuotaResetAt  DateTime? @map("last_quota_reset_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  products          Product[]
  usageMetrics      UsageMetric[]
  backupSnapshots   BackupSnapshot[]

  @@map("shops")
}

model Product {
  id                Int       @id @default(autoincrement())
  shopId            Int       @map("shop_id")
  shopifyProductId  String    @map("shopify_product_id")
  title             String    @default("")
  handle            String?
  description       String?   @default("")
  imageCount        Int       @default(0) @map("image_count")
  hasJsonLd         Boolean   @default(false) @map("has_json_ld")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  images            ProductImage[]
  altTextHistories  AltTextHistory[]

  @@unique([shopId, shopifyProductId])
  @@map("products")
}

model ProductImage {
  id                Int       @id @default(autoincrement())
  productId         Int       @map("product_id")
  shopifyImageId    String    @map("shopify_image_id")
  src               String
  altTextOriginal   String?   @default("") @map("alt_text_original")
  altTextAi         String?   @default("") @map("alt_text_ai")
  tagsOriginal      String?   @default("") @map("tags_original")
  tagsAi            String?   @default("") @map("tags_ai")
  status            String    @default("pending")
  hasJsonLd         Boolean   @default(false) @map("has_json_ld")
  position          Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  altTextHistories  AltTextHistory[]

  @@unique([productId, shopifyImageId])
  @@map("product_images")
}

model UsageMetric {
  id                Int       @id @default(autoincrement())
  shopId            Int       @map("shop_id")
  date              String    // format: "2026-01-01"
  imagesGenerated   Int       @default(0) @map("images_generated")
  tagsGenerated     Int       @default(0) @map("tags_generated")
  jsonLdGenerated   Int       @default(0) @map("json_ld_generated")
  apiCalls          Int       @default(0) @map("api_calls")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, date])
  @@map("usage_metrics")
}

model AltTextHistory {
  id                Int       @id @default(autoincrement())
  imageId           Int       @map("image_id")
  productId         Int       @map("product_id")
  previousAltText   String?   @default("") @map("previous_alt_text")
  newAltText        String    @default("") @map("new_alt_text")
  source            String    @default("manual") // manual, ai
  createdAt         DateTime  @default(now()) @map("created_at")

  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  image             ProductImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@map("alt_text_histories")
}

model BackupSnapshot {
  id                String    @id @default(cuid())
  shopId            Int       @map("shop_id")
  data              String    // JSON string
  productCount      Int       @default(0) @map("product_count")
  imageCount        Int       @default(0) @map("image_count")
  createdAt         DateTime  @default(now()) @map("created_at")

  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("backup_snapshots")
}

model OnboardingState {
  id                Int       @id @default(autoincrement())
  shopId            Int       @unique @map("shop_id")
  completed         Boolean   @default(false)
  currentStep       String    @default("welcome") @map("current_step")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("onboarding_states")
}
