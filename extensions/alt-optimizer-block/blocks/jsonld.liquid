{% comment %}
  AltOptimizer JSON-LD Structured Data Block
  Automatically injects Product schema JSON-LD into product pages
  when the product has an altoptimizer.jsonld metafield.
{% endcomment %}

{% if product and product.metafields.altoptimizer.jsonld %}
<script type="application/ld+json">
{{ product.metafields.altoptimizer.jsonld.value }}
</script>
{% endif %}

{% schema %}
{
  "name": "AltOptimizer JSON-LD",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": []
}
{% endschema %}
